template("msvc_toolchain") {
  assert(defined(invoker.toolchain_cpu))
  assert(invoker.toolchain_cpu == "x64" || invoker.toolchain_cpu == "arm64")

  toolchain(target_name) {
    tool("cc") {
      command = "cl.exe /nologo /showIncludes @{{output}}.rsp /c {{source}} /Fo{{output}}"
      description = "CC {{output}}"
      outputs = [ "{{source_out_dir}}/{{source_name_part}}.obj" ]
      rspfile = "{{output}}.rsp"
      rspfile_content = "{{defines}} {{include_dirs}} {{cflags}} {{cflags_c}}"
      depsformat = "msvc"
    }

    tool("cxx") {
      command = "cl.exe /nologo /showIncludes @{{output}}.rsp /c {{source}} /Fo{{output}}"
      description = "CXX {{output}}"
      outputs = [ "{{source_out_dir}}/{{source_name_part}}.obj" ]
      rspfile = "{{output}}.rsp"
      rspfile_content = "{{defines}} {{include_dirs}} {{cflags}} {{cflags_cc}}"
      depsformat = "msvc"
    }

    tool("alink") {
      command = "lib.exe /nologo /OUT:{{output}} @{{output}}.rsp"
      description = "LIB {{output}}"
      default_output_extension = ".lib"
      output_prefix = ""
      outputs =
          [ "{{target_out_dir}}/{{target_output_name}}{{output_extension}}" ]
      rspfile = "{{output}}.rsp"
      rspfile_content = "{{inputs}}"
    }

    tool("solink") {
      command = "link.exe /nologo /DLL /OUT:{{output}} /IMPLIB:{{target_out_dir}}/{{target_output_name}}.lib @{{output}}.rsp"
      description = "LINK(DLL) {{output}}"
      default_output_extension = ".dll"
      output_prefix = ""
      outputs = [
        "{{root_out_dir}}/{{target_output_name}}{{output_extension}}",
        "{{target_out_dir}}/{{target_output_name}}.lib",
      ]
      link_output = "{{target_out_dir}}/{{target_output_name}}.lib"
      depend_output = "{{target_out_dir}}/{{target_output_name}}.lib"
      runtime_outputs =
          [ "{{root_out_dir}}/{{target_output_name}}{{output_extension}}" ]
      rspfile = "{{output}}.rsp"
      rspfile_content = "{{inputs}} {{solibs}} {{libs}} {{rlibs}} {{ldflags}}"
    }

    tool("link") {
      command = "link.exe /nologo /OUT:{{output}} @{{output}}.rsp"
      description = "LINK {{output}}"
      default_output_extension = ".exe"
      output_prefix = ""
      outputs =
          [ "{{root_out_dir}}/{{target_output_name}}{{output_extension}}" ]
      rspfile = "{{output}}.rsp"
      rspfile_content = "{{inputs}} {{solibs}} {{libs}} {{rlibs}} {{ldflags}}"
    }

    tool("stamp") {
      command = "cmd.exe /d /c \"type nul > {{output}}\""
      description = "STAMP {{output}}"
    }

    tool("copy") {
      command = "cmd.exe /d /c \"copy /y {{source}} {{output}} > nul\""
      description = "COPY {{source}} {{output}}"
    }

    toolchain_args = {
      current_os = "win"
      current_cpu = invoker.toolchain_cpu
      is_clang = false
      is_msvc = true
    }
  }
}
