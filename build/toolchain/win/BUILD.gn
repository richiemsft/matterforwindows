import("msvc_toolchain.gni")

active_msvc_cpu = getenv("VSCMD_ARG_TGT_ARCH")
assert(
    active_msvc_cpu == target_cpu,
    "The active MSVC environment targets \"${active_msvc_cpu}\", but target_cpu is \"${target_cpu}\". Run scripts/setup/windows.ps1 with -Architecture ${target_cpu}.")

if (active_msvc_cpu == "x64") {
  msvc_toolchain("win_x64_msvc") {
    toolchain_cpu = "x64"
  }
} else if (active_msvc_cpu == "arm64") {
  msvc_toolchain("win_arm64_msvc") {
    toolchain_cpu = "arm64"
  }
} else {
  assert(false, "Unsupported MSVC target architecture: \"${active_msvc_cpu}\"")
}
