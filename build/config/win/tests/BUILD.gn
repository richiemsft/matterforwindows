# Real upstream src/transport/tests and src/protocols/secure_channel/tests
# GoogleTest suites, run against host-neutral canonical splits of
# //src/transport and //src/protocols/secure_channel compiled with native MSVC
# (//src/transport:crypto-context, //src/transport:group-peer-message-counter,
# //src/protocols/secure_channel:type_definitions, :check-in-counter, and
# :session-resumption-storage). They link only the canonical //src/crypto,
# //src/inet, //src/system, and //src/lib libraries; the session-establishment /
# exchange / MRP closures that reach the Device Layer
# (platform/ConnectivityManager.h) are out of scope for Phase 2.
# See //docs/guides/windows.md for the enabled/deferred inventory.

# A handful of upstream transport/secure_channel test bodies and vector headers
# use GCC/Clang C++17 extensions (designated-initializer aggregates, unsized
# empty arrays) that MSVC rejects under /std:c++17. As with the crypto suites,
# gen_msvc_cxx17_source.py emits C++17 build-artifact copies into a private gen
# directory; the upstream files are untouched and the known-answer assertions
# validate every rewrite at runtime.
_transport_cxx17_dir = "$target_gen_dir/transport_cxx17"

action_foreach("gen_transport_cxx17") {
  script = "gen_msvc_cxx17_source.py"
  sources = [ "//src/transport/tests/TestCryptoContext.cpp" ]
  outputs = [ "$_transport_cxx17_dir/{{source_file_part}}" ]
  args = [
    "{{source}}",
    rebase_path("$_transport_cxx17_dir/{{source_file_part}}", root_build_dir),
  ]
}

# SecureChannel protocol/session suites that allocate but do not self-init
# memory (shared memory-initializing main):
#   - TestCheckInCounter: the monotonic ICD check-in counter.
#   - TestDefaultSessionResumptionStorage / TestSimpleSessionResumptionStorage:
#     session-resumption record storage.
#
# TestCheckinMsg is deferred: its vectors are pulled in via an angle-bracket
# full path (<protocols/secure_channel/tests/CheckIn_Message_test_vectors.h>)
# that the same-directory C++17 transform used elsewhere cannot shadow, and that
# header's structure is not handled by gen_msvc_cxx17_source.py. See
# //docs/guides/windows.md.
executable("msvc-secure-channel-tests") {
  sources = [
    "//src/protocols/secure_channel/tests/TestCheckInCounter.cpp",
    "//src/protocols/secure_channel/tests/TestDefaultSessionResumptionStorage.cpp",
    "//src/protocols/secure_channel/tests/TestSimpleSessionResumptionStorage.cpp",
    "msvc_crypto_test_main.cpp",
    "msvc_stringbuilder_adapters.cpp",
  ]
  output_dir = root_out_dir

  configs += [
    ":system-inet-upstream-test-config",
    "//build/config/win:upstream_sdk_warnings",
  ]

  deps = [
    "//build/config/win/googletest",
    "//src/protocols/secure_channel:check-in-counter",
    "//src/protocols/secure_channel:session-resumption-storage",
  ]
}

