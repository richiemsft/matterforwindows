assert(current_os == "win")

executable("msvc-toolchain-smoke") {
  sources = [ "msvc_toolchain_smoke.cpp" ]
  output_dir = root_out_dir
}

executable("msvc-sdk-smoke") {
  sources = [ "msvc_sdk_smoke.cpp" ]
  output_dir = root_out_dir
  include_dirs = [ "//src" ]
  deps = [ "//src/lib/support/base64" ]
}

executable("msvc-dependency-smoke") {
  sources = [ "msvc_dependency_smoke.cpp" ]
  output_dir = root_out_dir
  deps = [
    "//third_party/boringssl/repo:boringssl",
    "//third_party/jsoncpp",
    "//third_party/mbedtls",
  ]
}

executable("msvc-core-unit-tests") {
  sources = [
    "../../../../src/lib/core/tests/TestCHIPError.cpp",
    "../../../../src/lib/core/tests/TestCHIPKeyIds.cpp",
    "msvc_core_test_main.cpp",
  ]
  output_dir = root_out_dir

  configs += [ ":pw-unit-test-override" ]
  deps = [
    "//build/config/win/googletest",
    "//src/lib/core/windows:windows-core-portable",
  ]
}

config("pw-unit-test-override") {
  include_dirs = [ "pw_unit_test_override" ]
  cflags = [ "/wd4389" ]
}

executable("msvc-system-primitives-smoke") {
  sources = [ "msvc_system_primitives_smoke.cpp" ]
  output_dir = root_out_dir
  deps = [ "//src/system/windows:windows-system-shared-compile" ]
}

executable("msvc-system-error-source-smoke") {
  sources = [
    "../../../../src/lib/core/CHIPError.cpp",
    "../../../../src/lib/core/ErrorStr.cpp",
    "../../../../src/system/SystemError.cpp",
    "msvc_system_error_source_smoke.cpp",
  ]
  output_dir = root_out_dir
  configs += [
    ":error-source",
    "//src/lib/core/windows:public",
    "//src/system/windows:public",
    "//src/system/windows:system-config",
  ]
}

executable("msvc-system-wake-event-smoke") {
  sources = [ "msvc_system_wake_event_smoke.cpp" ]
  output_dir = root_out_dir
  deps = [
    "//src/lib/core/windows:windows-core-portable",
    "//src/system/windows:windows-system-primitives",
  ]
}

executable("msvc-system-layer-smoke") {
  sources = [ "msvc_system_layer_smoke.cpp" ]
  output_dir = root_out_dir
  deps = [ "//src/system/windows:windows-system-layer" ]
}

config("error-source") {
  defines = [ "CHIP_CONFIG_ERROR_SOURCE=1" ]
}

executable("msvc-socket-smoke") {
  sources = [ "msvc_socket_smoke.cpp" ]
  output_dir = root_out_dir
  deps = [ "//src/inet/windows:windows-socket" ]
}

executable("msvc-inet-interface-smoke") {
  sources = [ "msvc_inet_interface_smoke.cpp" ]
  output_dir = root_out_dir
  deps = [ "//src/inet/windows:windows-interface" ]
}

executable("msvc-inet-udp-endpoint-smoke") {
  sources = [ "msvc_inet_udp_endpoint_smoke.cpp" ]
  output_dir = root_out_dir
  deps = [ "//src/inet/windows:windows-udp-endpoint" ]
}
