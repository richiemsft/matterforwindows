import("//build/config/compiler/compiler.gni")

assert(current_os == "win")
assert(is_msvc)

config("default") {
  defines = [
    "NOMINMAX",
    "WIN32_LEAN_AND_MEAN",
    "_CRT_SECURE_NO_WARNINGS",
    "_HAS_EXCEPTIONS=0",
  ]

  cflags = [
    "/nologo",
    "/W4",
    "/WX",
    "/utf-8",
    "/Zc:__cplusplus",
    "/Zc:preprocessor",
    "/permissive-",
    "/GR-",
    "/EHs-c-",
    "/Gy",
    "/Gw",
  ]

  cflags_cc = [ "/std:c++17" ]

  if (is_debug) {
    cflags += [
      "/MDd",
      "/Od",
      "/Zi",
    ]
  } else {
    cflags += [
      "/MD",
      "/O2",
    ]
  }
}

config("executable") {
  ldflags = [ "/OPT:REF" ]

  if (is_debug) {
    ldflags += [ "/DEBUG" ]
  } else {
    ldflags += [ "/OPT:ICF" ]
  }
}
