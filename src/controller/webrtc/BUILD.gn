import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")

import("${chip_root}/build/chip/tools.gni")
import("${chip_root}/src/app/common_flags.gni")
import("${chip_root}/src/controller/flags.gni")

import("${chip_root}/build/chip/buildconfig_header.gni")

if (chip_build_webrtc_signaling) {
  source_set("chip_webrtc_signaling") {
    sources = [
      "CameraProviderClient.cpp",
      "CameraProviderClient.h",
      "CameraRequestorEndpoint.cpp",
      "CameraRequestorEndpoint.h",
      "CameraSignalingCluster.cpp",
      "CameraSignalingCluster.h",
    ]
    public_deps = [
      "${chip_root}/src/access",
      "${chip_root}/src/app/clusters/bindings",
      "${chip_root}/src/app/clusters/descriptor",
      "${chip_root}/src/app/clusters/webrtc-transport-requestor-server",
      "${chip_root}/src/controller:interactions",
      "${chip_root}/src/credentials",
      "${chip_root}/src/data-model-providers/codedriven",
      "${chip_root}/src/data-model-providers/codegen:headers",
      "${chip_root}/zzz_generated/app-common/clusters/CameraAvStreamManagement",
      "${chip_root}/zzz_generated/app-common/clusters/Descriptor",
      "${chip_root}/zzz_generated/app-common/clusters/WebRTCTransportProvider",
    ]
  }
}

static_library("chip_webrtc") {
  sources = [
    "${chip_root}/src/controller/python/matter/native/PyChipError.h",
    "WebRTCClient.cpp",
    "WebRTCClient.h",
    "WebRTCTransportProviderClient.cpp",
    "WebRTCTransportProviderClient.h",
    "WebRTCTransportRequestorManager.cpp",
    "WebRTCTransportRequestorManager.h",
  ]

  include_dirs = [
    "${chip_root}/src/controller/webrtc/",
    "${chip_root}/src/lib/support",
    "${chip_root}/third_party/libdatachannel/repo/include",
  ]

  public_deps = [ "${chip_root}/src/data-model-providers/codegen:headers" ]

  deps = [
    "${chip_root}/src/app:interaction-model",
    "${chip_root}/src/app/clusters/webrtc-transport-requestor-server",
    "${chip_root}/src/app/server",
    "${chip_root}/src/controller/webrtc/access_control",
    "${chip_root}/src/lib/support",
    "${chip_root}/src/platform",
    "${chip_root}/third_party/libdatachannel",
  ]
}
