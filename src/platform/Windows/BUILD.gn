# Phase 3 Windows Device Layer foundation.
#
# This focused target composes the native System::LayerImplWindows event loop
# with the standard PlatformManager lifecycle, cross-thread work posting, and
# shutdown contracts. It deliberately does NOT pull the full Device Layer
# manager closure (Configuration, Connectivity, KeyValueStore, DNS-SD, BLE):
# those are later phases and are not stubbed here.

assert(current_os == "win")

import("//build_overrides/chip.gni")
import("${chip_root}/src/platform/device.gni")

# Selects the Windows platform header set and exposes the Windows device
# platform configuration to every consumer of the foundation library.
config("windows-device-layer-config") {
  defines = [
    "CHIP_DEVICE_LAYER_TARGET=Windows",
    "CHIP_DEVICE_PLATFORM_CONFIG_INCLUDE=<platform/Windows/CHIPDevicePlatformConfig.h>",
  ]

  include_dirs = [
    "//src",
    "//src/include",
  ]
}

config("windows-generated-header-config") {
  include_dirs = [
    "$root_gen_dir/include",
    "//zzz_generated/app-common",
  ]
  cflags = [
    "/FIplatform/Windows/MsvcCompilerCompatibility.h",
    "/wd4068",
    "/wd4130",
    "/wd4505",
    "/wd4702",
  ]
}

static_library("windows-platform-manager") {
  sources = [
    "../DeviceSafeQueue.cpp",
    "../DeviceSafeQueue.h",
    "//src/include/platform/internal/GenericPlatformManagerImpl_Windows.h",
    "//src/include/platform/internal/GenericPlatformManagerImpl_Windows.ipp",
    "BlePlatformConfig.h",
    "CHIPDevicePlatformConfig.h",
    "CHIPDevicePlatformEvent.h",
    "CHIPPlatformConfig.h",
    "InetPlatformConfig.h",
    "PlatformManagerImpl.cpp",
    "PlatformManagerImpl.h",
    "SystemLayerGlobals.cpp",
    "SystemPlatformConfig.h",
  ]

  public_deps = [
    "//src/lib/core/windows:windows-core-portable",
    "//src/system/windows:windows-system-layer",
  ]

  public_configs = [ ":windows-device-layer-config" ]

  libs = [ "Ws2_32.lib" ]
}

# Canonical-config twin of ":windows-platform-manager" above: compiles the
# same PlatformManagerImpl.cpp/DeviceSafeQueue.cpp, but
# against canonical //src/lib/core:core and //src/system:system instead of
# the ad hoc, command-line-configured //src/lib/core/windows:windows-core-portable
# and //src/system/windows:windows-system-layer. This is the target canonical
# //src/platform:platform depends on for chip_device_platform=="windows" (see
# src/platform/BUILD.gn's "_platform_target"): //src/platform:platform's own
# "platform_base" sub-target already depends on canonical //src/lib/core,
# //src/system, etc., so depending on the ad hoc pair above here would relink
# a second, independently configured copy of CHIPError/TLV/the System Layer
# into the same binary -- an ODR/link conflict under /WX (see
# docs/guides/windows.md, "The Windows Device Layer foundation"). The plain
# ":windows-platform-manager" above is preserved unchanged for its existing
# standalone smoke (msvc-platform-manager-smoke) and every other Windows
# Device Layer target that still pairs with it (":windows-dnssd",
# ":windows-configuration-manager", ...).
static_library("windows-platform-manager-canonical") {
  sources = [
    "../DeviceSafeQueue.cpp",
    "../DeviceSafeQueue.h",
    "//src/include/platform/internal/GenericPlatformManagerImpl_Windows.h",
    "//src/include/platform/internal/GenericPlatformManagerImpl_Windows.ipp",
    "BlePlatformConfig.h",
    "CHIPDevicePlatformConfig.h",
    "CHIPDevicePlatformEvent.h",
    "CHIPPlatformConfig.h",
    "ConfigurationManagerImpl.cpp",
    "ConfigurationManagerImpl.h",
    "ConnectivityManagerImpl.cpp",
    "ConnectivityManagerImpl.h",
    "DiagnosticDataProviderImpl.cpp",
    "DiagnosticDataProviderImpl.h",
    "InetPlatformConfig.h",
    "KeyValueStoreManagerImpl.cpp",
    "KeyValueStoreManagerImpl.h",
    "MsvcCompilerCompatibility.h",
    "PlatformManagerImpl.cpp",
    "PlatformManagerImpl.h",
    "SystemPlatformConfig.h",
    "WindowsConfig.cpp",
    "WindowsConfig.h",
    "../SingletonConfigurationManager.cpp",
  ]

  public_deps = [
    "//src/app/common:enums",
    "//src/credentials:build_time_header",
    "//src/crypto:crypto",
    "//src/lib/core:core",
    "//src/system:system",
    "//third_party/nlio",
  ]

  defines = [ "CHIP_WINDOWS_DEVICE_LAYER_COMPOSITION=1" ]

  libs = [
    "Iphlpapi.lib",
    "Ole32.lib",
    "Shell32.lib",
    "Ws2_32.lib",
  ]

  # DnssdImpl.cpp is compiled directly into this target (rather than a
  # separate opt-in library, as the ad hoc ":windows-dnssd" is) to match how
  # every other chip_mdns_platform platform's own "_platform_target" composes
  # it (e.g. src/platform/Darwin/BUILD.gn's "Darwin" target includes
  # "dnssd/DnssdImpl.cpp" directly): //src/lib/dnssd:dnssd's chip_mdns_platform
  # sources (Discovery_ImplPlatform.cpp) publicly depend on the generic
  # //src/platform umbrella target, so the concrete backend needs to live
  # inside it, not bolted on separately.
  if (chip_mdns_platform) {
    sources += [
      "DnssdImpl.cpp",
      "DnssdImpl.h",
    ]
    public_deps += [
      "//src/inet:inet",
      "//src/lib/dnssd:naming",
      "//src/lib/dnssd:platform_header",
    ]
    libs += [
      "dnsapi.lib",
      "Iphlpapi.lib",
    ]
  }

  public_configs = [
    ":windows-device-layer-config",
    ":windows-generated-header-config",
  ]
}

# Native Windows key-value store foundation for controller fabric persistence.
#
# File-per-key under a per-user versioned root (%LOCALAPPDATA%\Matter\KVS\v1 by
# default, overridable at Init() time). Each value is written with an integrity
# header and durably replaced with a same-volume temp file + FlushFileBuffers +
# MoveFileEx, so a crash never yields a partial value. It is self-contained: it
# does not depend on ConfigurationManager or the rest of the Device Layer
# manager closure, so it can be exercised on its own while later phases land.
static_library("windows-key-value-store") {
  sources = [
    "KeyValueStoreManagerImpl.cpp",
    "KeyValueStoreManagerImpl.h",
  ]

  public_deps = [ "//src/lib/core/windows:windows-core-portable" ]

  # SystemError.cpp provides MapErrorWindows()/MapErrorHRESULT() behind the
  # CHIP_ERROR_WINDOWS() / CHIP_ERROR_HRESULT() macros this store maps its
  # native failures through.
  deps = [ "//src/system/windows:windows-system-errors" ]

  public_configs = [ ":windows-device-layer-config" ]

  # SHGetKnownFolderPath (Shell32), CoTaskMemFree, and GUID generation (Ole32)
  # resolve the Unicode known-folder root and collision-resistant temp names.
  libs = [
    "Shell32.lib",
    "Ole32.lib",
  ]
}

static_library("windows-configuration") {
  sources = [
    "WindowsConfig.cpp",
    "WindowsConfig.h",
  ]

  public_deps = [ ":windows-key-value-store" ]
  public_configs = [ ":windows-device-layer-config" ]
}

static_library("windows-connectivity-manager") {
  sources = [
    "ConnectivityManagerImpl.cpp",
    "ConnectivityManagerImpl.h",
  ]

  public_deps = [
    "//src/lib/core/windows:windows-core-portable",
    "//src/inet/windows:windows-tcp-endpoint",
    "//src/inet/windows:windows-udp-endpoint",
    "//src/system/windows:windows-system-layer",
    "//third_party/nlio",
  ]
  public_configs = [ ":windows-device-layer-config" ]
  libs = [ "Iphlpapi.lib" ]
