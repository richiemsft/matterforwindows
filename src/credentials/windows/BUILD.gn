import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")

import("${build_root}/config/compiler/compiler.gni")

assert(current_os == "win")

# Focused CHIPCert / attestation subset of //src/credentials needed by the
# upstream src/crypto/tests/TestChipCryptoPAL.cpp suite.
#
# The canonical monolithic //src/credentials:credentials target also compiles
# FabricTable, LastKnownGoodTime, GroupDataProvider, and PersistentStorage
# OpCertStore, which pull in the Windows Device Layer (platform storage,
# ConfigurationManager, generated setup_payload build configs) that is not part
# of this port yet. TestChipCryptoPAL references none of those translation
# units -- only certificate parsing / conversion / validation and the DAC
# attestation-format checks -- so this library lists exactly that subset and
# leaves the Device Layer untouched.
static_library("windows-chip-cert") {
  sources = [
    "../CHIPCert.cpp",
    "../CHIPCert.h",
    "../CHIPCertFromX509.cpp",
    "../CHIPCertToX509.cpp",
    "../CHIPCert_Internal.h",
    "../CHIPCertificateSet.h",
    "../CertificateValidityPolicy.h",
    "../CertificationDeclaration.cpp",
    "../CertificationDeclaration.h",
    "../DeviceAttestationConstructor.cpp",
    "../DeviceAttestationConstructor.h",
    "../DeviceAttestationVendorReserved.h",
    "../GenerateChipX509Cert.cpp",
    "../attestation_verifier/DeviceAttestationVerifier.cpp",
    "../attestation_verifier/DeviceAttestationVerifier.h",
  ]

  # Upstream GCC/Clang-authored sources are not /W4 /WX clean under MSVC.
  configs += [ "//build/config/win:upstream_sdk_warnings" ]

  public_deps = [
    "${chip_root}/src/crypto",
    "${chip_root}/src/lib/asn1",
    "${chip_root}/src/lib/core",
    "${chip_root}/src/lib/support",
  ]
}

# Upstream certificate test vectors used by TestChipCryptoPAL.cpp, compiled at
# the repository /std:c++17 default. CHIPCert_test_vectors.cpp and TestPAAStore
# .cpp express their byte arrays with C99/GCC compound literals
# ((const uint8_t[]){ ... }) that MSVC does not accept in C++ at all, so
# gen_msvc_cxx17_source.py rewrites them to equivalent named arrays in a C++17
# build-artifact copy; the upstream files are untouched. CHIPAttCert_test_
# vectors.cpp is already C++17-compatible and is compiled as-is.
_creds_cxx17_dir = "$target_gen_dir/creds_cxx17"

action_foreach("gen_creds_cxx17") {
  script = "//build/config/win/tests/gen_msvc_cxx17_source.py"
  sources = [
    "../attestation_verifier/TestPAAStore.cpp",
    "../tests/CHIPCert_test_vectors.cpp",
  ]
  outputs = [ "$_creds_cxx17_dir/{{source_file_part}}" ]
  args = [
    "{{source}}",
    rebase_path("$_creds_cxx17_dir/{{source_file_part}}", root_build_dir),
  ]
}

source_set("windows-cert-test-vectors") {
  sources = [
    # Already C++17-compatible; compiled as-is.
    "../tests/CHIPAttCert_test_vectors.cpp",
    "../tests/CHIPAttCert_test_vectors.h",

    # C++17 build-artifact copies (compound literals -> named arrays).
    "$_creds_cxx17_dir/CHIPCert_test_vectors.cpp",
    "$_creds_cxx17_dir/TestPAAStore.cpp",
  ]

  configs += [ "//build/config/win:upstream_sdk_warnings" ]

  # The transformed CHIPCert_test_vectors.cpp is compiled from the gen dir; its
  # quoted #include "CHIPCert_test_vectors.h" (an already-C++17-clean header)
  # resolves through the upstream directory here.
  include_dirs = [ "//src/credentials/tests" ]

  deps = [ ":gen_creds_cxx17" ]

  public_deps = [ ":windows-chip-cert" ]
}
