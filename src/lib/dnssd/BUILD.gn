import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")
import("${build_root}/config/compiler/compiler.gni")
import("${chip_root}/src/platform/device.gni")

source_set("constants") {
  sources = [ "Constants.h" ]

  public_deps = [ "${chip_root}/src/lib/support" ]
}

source_set("types") {
  sources = [ "Types.h" ]
}

source_set("naming") {
  sources = [
    "ServiceNaming.cpp",
    "ServiceNaming.h",
  ]

  public_deps = [
    ":constants",
    ":types",
    "${chip_root}/src/lib/core",
    "${chip_root}/src/lib/core:error",
    "${chip_root}/src/lib/support:span",
  ]

  if (is_msvc) {
    # ServiceNaming.cpp is not yet clean under the strict /W4 /WX Windows
    # default (a potentially-uninitialized-variable diagnostic); relax to the
    # shared upstream-SDK warning isolation, matching //src/transport's and
    # //src/credentials' canonical library splits.
    configs += [ "//build/config/win:upstream_sdk_warnings" ]
  }
}

source_set("platform_header") {
  sources = [
    "platform/Dnssd.h",
    "platform/DnssdBrowseDelegate.h",
  ]
  public_deps = [
    ":constants",
    ":naming",
    "${chip_root}/src/inet",
    "${chip_root}/src/lib/core",
    "${chip_root}/src/system",
  ]
}

if (is_msvc && chip_mdns_platform) {
  _dnssd_platform_cxx17_dir = "$target_gen_dir/dnssd_platform_cxx17"

  # Discovery_ImplPlatform.cpp uses C++20 designated-initializer aggregates
  # (accepted by GCC/Clang as a C++17 extension, rejected by MSVC as C7555
  # under the repository's /std:c++17 default). gen_msvc_cxx17_source.py
  # produces a C++17 build-time copy (positional aggregate initialization)
  # into a private gen directory; the upstream file is untouched.
  action_foreach("gen_dnssd_platform_cxx17") {
    script = "//build/config/win/tests/gen_msvc_cxx17_source.py"
    sources = [ "Discovery_ImplPlatform.cpp" ]
    outputs = [ "$_dnssd_platform_cxx17_dir/{{source_file_part}}" ]
    args = [
      "{{source}}",
      rebase_path("$_dnssd_platform_cxx17_dir/{{source_file_part}}",
                  root_build_dir),
    ]
  }
}

static_library("dnssd") {
  public_deps = [
    ":constants",
    ":platform_header",
    ":types",
    "${chip_root}/src/app/icd/server:icd-server-config",
    "${chip_root}/src/crypto",
    "${chip_root}/src/lib/core",
    "${chip_root}/src/lib/support",
    "${chip_root}/src/messaging:configurations",
  ]

  sources = [
    "Advertiser.cpp",
    "Advertiser.h",
    "IPAddressSorter.cpp",
    "IPAddressSorter.h",
    "Resolver.cpp",
    "Resolver.h",
    "ResolverProxy.cpp",
    "ResolverProxy.h",
    "TxtFields.cpp",
    "TxtFields.h",
  ]

  assert(
      chip_mdns == "none" || chip_mdns == "minimal" || chip_mdns == "platform",
      "Please select a valid value for chip_mdns")

  if (chip_mdns == "none") {
    sources += [
      "Advertiser_ImplNone.cpp",
      "Resolver_ImplNone.cpp",
    ]
  }

  if (chip_mdns_minimal) {
    sources += [
      "ActiveResolveAttempts.cpp",
      "ActiveResolveAttempts.h",
      "Advertiser_ImplMinimalMdns.cpp",
      "Advertiser_ImplMinimalMdnsAllocator.h",
      "IncrementalResolve.cpp",
      "IncrementalResolve.h",
      "MinimalMdnsServer.cpp",
      "MinimalMdnsServer.h",
      "Resolver_ImplMinimalMdns.cpp",
    ]
    public_deps += [
      "${chip_root}/src/lib/dnssd/minimal_mdns",
      "${chip_root}/src/lib/dnssd/wire",
      "${chip_root}/src/lib/dnssd/wire/records",
      "${chip_root}/src/tracing",
      "${chip_root}/src/tracing:macros",
    ]
  }

  if (chip_mdns_platform) {
    if (is_msvc) {
      sources += [
        "$target_gen_dir/dnssd_platform_cxx17/Discovery_ImplPlatform.cpp",
      ]
      deps = [ ":gen_dnssd_platform_cxx17" ]
    } else {
      sources += [ "Discovery_ImplPlatform.cpp" ]
    }
    sources += [ "Discovery_ImplPlatform.h" ]
    public_deps += [ "${chip_root}/src/platform" ]
  }

  _chip_dnssd_default_none = chip_mdns == "none"
  _chip_dnssd_default_minimal = chip_mdns == "minimal"
  _chip_dnssd_default_platform = chip_mdns == "platform"

  defines = [
    "CHIP_DNSSD_DEFAULT_NONE=${_chip_dnssd_default_none}",
    "CHIP_DNSSD_DEFAULT_MINIMAL=${_chip_dnssd_default_minimal}",
    "CHIP_DNSSD_DEFAULT_PLATFORM=${_chip_dnssd_default_platform}",
  ]

  cflags = []
  if (!is_msvc) {
    cflags += [ "-Wconversion" ]
  } else {
    # ServiceNaming.cpp/Discovery_ImplPlatform.cpp are not yet clean under the
    # strict /W4 /WX Windows default (a potentially-uninitialized-variable
    # diagnostic and other upstream-authored patterns); relax to the shared
    # upstream-SDK warning isolation, matching //src/transport's and
    # //src/credentials' canonical library splits.
    configs += [ "//build/config/win:upstream_sdk_warnings" ]
  }
}
