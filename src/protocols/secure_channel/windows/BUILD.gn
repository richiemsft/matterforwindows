import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")

import("${build_root}/config/compiler/compiler.gni")

assert(current_os == "win")

# Focused, host-neutral subsets of //src/protocols/secure_channel compiled with
# native MSVC for the Windows protocol/session unit tests. Like the transport
# subsets, these reuse //build/config/win:upstream_sdk_warnings (relaxing
# /W4 /WX and omitting the GNU -Wconversion flag the canonical secure_channel
# target passes) and link only the canonical //src/crypto, //src/inet,
# //src/system, and //src/lib libraries. The session-establishment translation
# units (PASESession, CASESession, PairingSession) are intentionally excluded:
# they pull in platform/ConnectivityManager.h (the Device Layer), which is out
# of scope for Phase 2.

_sc_win_deps = [
  "${chip_root}/src/crypto",
  "${chip_root}/src/inet",
  "${chip_root}/src/lib/core",
  "${chip_root}/src/lib/support",
  "${chip_root}/src/system",
]

# SecureChannel StatusReport message encode/parse. Used by TestStatusReport.
source_set("windows-sc-status-report") {
  sources = [ "../StatusReport.cpp" ]

  configs += [ "//build/config/win:upstream_sdk_warnings" ]

  public_deps = _sc_win_deps
}

# Monotonic Check-In counter. Used by TestCheckInCounter.
source_set("windows-sc-checkin-counter") {
  sources = [ "../CheckInCounter.cpp" ]

  configs += [ "//build/config/win:upstream_sdk_warnings" ]

  public_deps = _sc_win_deps
}

# Session resumption storage (the abstract default and the simple in-storage
# implementation). Used by TestDefaultSessionResumptionStorage and
# TestSimpleSessionResumptionStorage.
source_set("windows-sc-resumption-storage") {
  sources = [
    "../DefaultSessionResumptionStorage.cpp",
    "../SimpleSessionResumptionStorage.cpp",
  ]

  configs += [ "//build/config/win:upstream_sdk_warnings" ]

  public_deps = _sc_win_deps
}
