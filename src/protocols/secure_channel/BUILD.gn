import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")
import("${build_root}/config/compiler/compiler.gni")

source_set("check-in-counter") {
  sources = [
    "CheckInCounter.cpp",
    "CheckInCounter.h",
  ]

  if (is_msvc) {
    # cl.exe rejects the GCC/Clang -Wconversion flag other secure_channel
    # targets pass, and this upstream body is not clean under the strict
    # /W4 /WX Windows default; relax it to the shared upstream-SDK isolation so
    # the Windows port can compile and unit-test the check-in counter.
    configs += [ "//build/config/win:upstream_sdk_warnings" ]
  }

  public_deps = [
    "${chip_root}/src/lib/core",
    "${chip_root}/src/lib/support",
  ]

  deps = [ "${chip_root}/src/crypto" ]
}

source_set("check-in-message") {
  sources = [
    "CheckinMessage.cpp",
    "CheckinMessage.h",
  ]

  public_deps = [ ":check-in-counter" ]

  deps = [
    ":type_definitions",
    "${chip_root}/src/crypto",
    "${chip_root}/src/lib/core",
    "${chip_root}/src/lib/support",
  ]
}

static_library("type_definitions") {
  output_name = "libSecureChannelTypes"

  sources = [
    "Constants.h",
    "StatusReport.cpp",
    "StatusReport.h",
  ]

  cflags = []
  if (is_msvc) {
    # cl.exe rejects the GCC/Clang -Wconversion flag and this upstream body is
    # not clean under the strict /W4 /WX Windows default; relax it to the shared
    # upstream-SDK isolation for the Windows port.
    configs += [ "//build/config/win:upstream_sdk_warnings" ]
  } else {
    cflags += [ "-Wconversion" ]
  }

  public_deps = [
    "${chip_root}/src/lib/support:type-traits",
    "${chip_root}/src/protocols:type_definitions",
    "${chip_root}/src/system",
  ]

  deps = [ "${chip_root}/src/lib/support" ]
}

# Host-neutral session-resumption record storage (the abstract default and the
# simple in-storage implementation). Split out of the monolithic :secure_channel
# target so the native Windows port can compile and unit-test it without the
# session-establishment / exchange closure that reaches //src/platform (the
# Device Layer). It is a public dependency of :secure_channel, so every platform
# still builds these translation units into libSecureChannel.
source_set("session-resumption-storage") {
  sources = [
    "DefaultSessionResumptionStorage.cpp",
    "DefaultSessionResumptionStorage.h",
    "SessionResumptionStorage.h",
    "SimpleSessionResumptionStorage.cpp",
    "SimpleSessionResumptionStorage.h",
  ]

  cflags = []
  if (is_msvc) {
    configs += [ "//build/config/win:upstream_sdk_warnings" ]
  } else {
    cflags += [ "-Wconversion" ]
  }

  public_deps = [
    "${chip_root}/src/crypto",
    "${chip_root}/src/inet",
    "${chip_root}/src/lib/core",
    "${chip_root}/src/lib/support",
    "${chip_root}/src/system",
  ]
}

static_library("secure_channel") {
  output_name = "libSecureChannel"

  sources = [
    "CASEDestinationId.cpp",
    "CASEDestinationId.h",
    "CASEServer.cpp",
    "CASEServer.h",
    "CASESession.cpp",
    "CASESession.h",
    "PASESession.cpp",
    "PASESession.h",
    "PairingSession.cpp",
    "PairingSession.h",
    "RendezvousParameters.h",
    "SessionEstablishmentDelegate.h",
    "SessionEstablishmentExchangeDispatch.cpp",
    "SessionEstablishmentExchangeDispatch.h",
    "UnsolicitedStatusHandler.cpp",
    "UnsolicitedStatusHandler.h",
  ]

  cflags = []
  if (!is_msvc) {
    cflags += [ "-Wconversion" ]
  }

  public_deps = [
    ":check-in-message",
    ":session-resumption-storage",
    ":type_definitions",
    "${chip_root}/src/crypto",
    "${chip_root}/src/lib/core",
    "${chip_root}/src/lib/support",
    "${chip_root}/src/lib/support:type-traits",
    "${chip_root}/src/messaging",
    "${chip_root}/src/system",
    "${chip_root}/src/tracing",
    "${chip_root}/src/tracing:macros",
    "${chip_root}/src/transport",
  ]

  deps = [ "${chip_root}/src/app:constants" ]
}
