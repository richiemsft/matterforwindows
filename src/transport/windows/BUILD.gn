import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")

import("${build_root}/config/compiler/compiler.gni")

assert(current_os == "win")

# Focused, host-neutral subsets of //src/transport compiled with native MSVC for
# the Windows transport unit tests. The canonical //src/transport:transport
# target passes the GCC/Clang -Wconversion flag (rejected by cl.exe as an
# invalid numeric argument) and builds at the strict /W4 /WX default; these
# source_sets instead reuse //build/config/win:upstream_sdk_warnings (which both
# relaxes /W4 /WX for the upstream GCC/Clang-authored bodies and omits the GNU
# -Wconversion flag). They link only against the canonical //src/crypto,
# //src/inet, //src/system, and //src/lib libraries -- no Device Layer.
#
# The SecureSession object itself is deliberately NOT built here: its MRP
# timeout virtuals (GetAckTimeout / GetMessageReceiptTimeout) call
# chip::GetRetransmissionTimeout, which links ReliableMessageMgr::GetBackoff
# from //src/messaging/ReliableMessageMgr.cpp -- a translation unit that
# includes platform/ConnectivityManager.h (the Device Layer, out of scope for
# Phase 2). TestPeerConnections and TestSecureSessionTable are deferred for that
# reason;
# see //docs/guides/windows.md.

_transport_win_deps = [
  "${chip_root}/src/crypto",
  "${chip_root}/src/inet",
  "${chip_root}/src/lib/core",
  "${chip_root}/src/lib/support",
  "${chip_root}/src/system",
]

# Message-layer crypto: the CryptoContext AEAD key schedule / nonce / privacy
# transform and the raw PacketHeader (MessageHeader) it encrypts around. Used by
# TestCryptoContext and TestSecureSession (the latter exercises only
# CryptoContext despite its name).
source_set("windows-transport-crypto-context") {
  sources = [
    "../CryptoContext.cpp",
    "../raw/MessageHeader.cpp",
  ]

  configs += [ "//build/config/win:upstream_sdk_warnings" ]

  public_deps = _transport_win_deps
}

# Group peer message-counter window/table logic. Used by
# TestGroupMessageCounter.
source_set("windows-transport-group-counter") {
  sources = [ "../GroupPeerMessageCounter.cpp" ]

  configs += [ "//build/config/win:upstream_sdk_warnings" ]

  public_deps = _transport_win_deps
}
