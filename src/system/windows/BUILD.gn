assert(current_os == "win")

static_library("windows-system-primitives") {
  sources = [
    "WindowsClock.cpp",
    "WindowsClock.h",
    "WindowsMutex.h",
    "WindowsWakeEvent.cpp",
    "WindowsWakeEvent.h",
  ]

  deps = [ ":windows-system-errors" ]
  public_configs = [ ":public" ]
  libs = [ "Ws2_32.lib" ]
}

# Canonical-config twin of ":windows-system-primitives" above: compiles the
# same WindowsClock.cpp/WindowsWakeEvent.cpp, but against canonical
# //src/lib/core:error's generated CHIPBuildConfig.h instead of
# windows-core-portable's command-line-defined config. This is the target
# canonical //src/system:system depends on (see src/system/BUILD.gn): system
# already compiles its own SystemError.cpp (also canonical), so this target
# does NOT depend on a SystemError.cpp compile itself -- doing so would
# recompile it a second time, against windows-core-portable's independently
# configured CHIPBuildConfig macros, which is an ODR/link conflict once both
# copies land in the same binary (see docs/guides/windows.md, "The Windows
# Device Layer foundation"). Standalone consumers that don't link canonical
# //src/system:system (e.g. msvc-system-wake-event-smoke) add
# ":windows-system-errors-canonical" themselves -- the canonical-config twin
# of ":windows-system-errors", not the plain one, since
# MapErrorWindows()'s overload set depends on CHIP_CONFIG_ERROR_SOURCE, which
# the two configs disagree on (see ":windows-system-errors-canonical" below).
static_library("windows-system-primitives-canonical") {
  sources = [
    "WindowsClock.cpp",
    "WindowsClock.h",
    "WindowsMutex.h",
    "WindowsWakeEvent.cpp",
    "WindowsWakeEvent.h",
  ]

  public_deps = [ "//src/lib/core:error" ]

  # Neither source references a CHIP_SYSTEM_CONFIG_*/INET_CONFIG_* macro, so
  # ":system-config" (which -- like windows-core-portable's ":public" --
  # redundantly hardcodes the same CHIPBuildConfig-controlled logging macros
  # as literal command-line defines) is deliberately not applied here: doing
  # so would conflict with canonical //src/lib/core:error's generated
  # CHIPBuildConfig.h under /WX.
  public_configs = [ ":public" ]
  libs = [ "Ws2_32.lib" ]
}

static_library("windows-system-errors") {
  sources = [
    "../SystemError.cpp",
    "../SystemError.h",
  ]

  deps = [ "//src/lib/core/windows:windows-core-portable" ]
  public_configs = [
    ":public",
    ":system-config",
  ]
}

# Canonical-config twin of ":windows-system-errors" above: compiles the same
# SystemError.cpp, but against canonical //src/lib/core:error's generated
# CHIPBuildConfig.h/SystemBuildConfig.h (CHIP_CONFIG_ERROR_SOURCE=1 from
# platform/Windows/CHIPPlatformConfig.h once CHIP_HAVE_CONFIG_H is set,
# selecting MapErrorWindows()'s 3-argument overload) instead of
# windows-core-portable's command-line-defined config (CHIP_CONFIG_ERROR_SOURCE
# defaults to 0, the 1-argument overload). ":windows-system-primitives-canonical"'s
# WindowsWakeEvent.cpp is compiled the same (canonical) way, so this is the
# only target that pairs with it without an overload-set/link mismatch. For
# canonical //src/system:system, MapErrorWindows() is instead supplied by
# system's own compiled SystemError.cpp (also canonical), so this target is
# not part of that dependency graph -- only the standalone smoke below uses
# it. ":system-config" is deliberately not applied (see ":windows-system-errors"
# above); canonical //src/lib/core:error's generated headers already supply
# equivalent CHIP_SYSTEM_CONFIG_* values.
static_library("windows-system-errors-canonical") {
  sources = [
    "../SystemError.cpp",
    "../SystemError.h",
  ]

  public_deps = [ "//src/lib/core:error" ]
  public_configs = [ ":public" ]
}

static_library("windows-system-shared-compile") {
  sources = [
    "../../lib/support/TimeUtils.cpp",
    "../SystemClock.cpp",
    "../SystemClock.h",
    "../SystemConfig.h",
    "../SystemMutex.cpp",
    "../SystemMutex.h",
  ]

  deps = [
    ":windows-system-errors",
    ":windows-system-primitives",
    "//src/lib/core/windows:windows-core-portable",
  ]
  public_configs = [
    ":public",
    ":system-config",
  ]
}

static_library("windows-system-layer") {
  sources = [
    "../../lib/support/Pool.cpp",
    "../../lib/support/Pool.h",
    "../../lib/support/TimeUtils.cpp",
    "../SystemClock.cpp",
    "../SystemClock.h",
    "../SystemTimer.cpp",
    "../SystemTimer.h",
    "SystemLayerImplWindows.cpp",
    "SystemLayerImplWindows.h",
  ]

  deps = [
    ":windows-system-errors",
    ":windows-system-primitives",
    "//src/lib/core/windows:windows-core-portable",
  ]
  public_configs = [
    ":public",
    ":system-config",
  ]
}

# CHIP_SYSTEM_CONFIG_*/INET_CONFIG_* selection for the sockets-based Windows
# System/Inet backend. The focused, command-line-configured Windows targets
# still use the logging and clock values here; canonical targets do not apply
# this config and receive those values from generated build headers instead.
config("system-config") {
  defines = [
    "CHIP_DEVICE_LAYER_USE_ATOMICS_FOR_CLOCK=0",
    "CHIP_AUTOMATION_LOGGING=0",
    "CHIP_DETAIL_LOGGING=0",
    "CHIP_ERROR_LOGGING=0",
    "CHIP_PROGRESS_LOGGING=0",
    "CHIP_SYSTEM_CONFIG_PLATFORM_PROVIDES_TIME=0",
    "CHIP_SYSTEM_CONFIG_USE_LWIP=0",
    "CHIP_SYSTEM_CONFIG_USE_NETWORK_FRAMEWORK=0",
    "CHIP_SYSTEM_CONFIG_USE_OPENTHREAD_ENDPOINT=0",
    "CHIP_SYSTEM_CONFIG_USE_POSIX_SOCKETS=0",
    "CHIP_SYSTEM_CONFIG_USE_POSIX_TIME_FUNCTS=0",
    "CHIP_SYSTEM_CONFIG_USE_SOCKETS=1",
    "INET_CONFIG_ENABLE_TCP_ENDPOINT=1",
    "INET_CONFIG_ENABLE_UDP_ENDPOINT=1",
    "INET_CONFIG_NUM_TCP_ENDPOINTS=4",
    "INET_CONFIG_NUM_UDP_ENDPOINTS=4",
  ]
}

config("public") {
  include_dirs = [
    "//src",
    "//src/include",
  ]
}
